{
  "name": "@mb-it-org/cli",
  "version": "1.0.1",
  "type": "module",
  "bin": {
    "mbs": "bin/run.js"
  },
  "oclif": {
    "bin": "mbs",
    "dirname": "mbs",
    "commands": {
      "strategy": "pattern",
      "glob": "dist/commands/**/*.js",
      "target": "./dist/commands"
    },
    "topicSeparator": " ",
    "plugins": [
      "@mb-it-org/ars",
      "@mb-it-org/doris",
      "@mb-it-org/export",
      "@mb-it-org/fars",
      "@mb-it-org/legacy",
      "@mb-it-org/oms",
      "@mb-it-org/org",
      "@mb-it-org/pim",
      "@mb-it-org/pms",
      "@mb-it-org/prm",
      "@mb-it-org/scm",
      "@mb-it-org/test"
    ],
    "additionalVersionFlags": [],
    "node": {
      "version": "20.19.1"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "oclif.manifest.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cj620/mbs-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/cj620/mbs-cli#readme",
  "bugs": {
    "url": "https://github.com/cj620/mbs-cli/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-skills.cjs",
    "dev": "tsc --watch",
    "test:dashboard-layout": "node scripts/check-dashboard-layout.mjs",
    "test": "pnpm exec vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@mb-it-org/ars": "workspace:*",
    "@mb-it-org/doris": "workspace:*",
    "@mb-it-org/export": "workspace:*",
    "@mb-it-org/fars": "workspace:*",
    "@mb-it-org/legacy": "workspace:*",
    "@mb-it-org/oms": "workspace:*",
    "@mb-it-org/org": "workspace:*",
    "@mb-it-org/pim": "workspace:*",
    "@mb-it-org/pms": "workspace:*",
    "@mb-it-org/prm": "workspace:*",
    "@mb-it-org/scm": "workspace:*",
    "@mb-it-org/shared": "workspace:*",
    "@mb-it-org/test": "workspace:*",
    "@oclif/core": "^4",
    "fastify": "^4.28.1",
    "playwright-core": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "oclif": "^4",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
