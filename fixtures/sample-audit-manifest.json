{
  "schemaVersion": "1",
  "manifestVersion": "2026-05-20T00:00:00+08:00",
  "modules": [
    {
      "domain": "account",
      "service": "account-center-service",
      "pathPrefix": "/account",
      "description": "账号分页查询",
      "keywords": ["账号", "account", "分页", "列表"],
      "scenarios": "按账号编码、业务编码、状态、邮箱、手机号等条件分页查询账号列表。",
      "actions": [
        {
          "name": "page",
          "description": "分页获取账号列表",
          "method": "POST",
          "path": "/page",
          "request": {
            "body": {
              "type": "object",
              "properties": {
                "currentPage": { "type": "integer", "description": "当前页" },
                "pageSize": { "type": "integer", "description": "每页大小" },
                "id": { "type": "integer", "description": "账号ID" },
                "code": { "type": "string", "description": "账号编码" },
                "busCode": { "type": "string", "description": "业务编码" },
                "status": { "type": "integer", "description": "账号状态" },
                "account": { "type": "string", "description": "账号" },
                "platform": { "type": "string", "description": "平台" },
                "hostType": { "type": "integer", "description": "托管方式" },
                "email": { "type": "string", "description": "邮箱" },
                "phone": { "type": "string", "description": "手机号" },
                "accountType": { "type": "string", "description": "账号类型" },
                "passwordUpdateTime": {
                  "type": "array",
                  "description": "密码修改时间区间",
                  "items": { "type": "string" }
                },
                "hasExpired": { "type": "boolean", "description": "密码是否过期" },
                "incorrect": { "type": "integer", "description": "是否错误" },
                "enabled": { "type": "boolean", "description": "是否启用" },
                "groupCompanyId": { "type": "integer", "description": "公司ID" }
              }
            }
          },
          "response": {
            "type": "object",
            "properties": {
              "code": { "type": "integer", "description": "响应状态码" },
              "message": { "type": "string", "description": "响应消息" },
              "data": {
                "type": "object",
                "description": "分页结果",
                "properties": {
                  "total": { "type": "integer", "description": "总条数" },
                  "totalPage": { "type": "integer", "description": "总页数" },
                  "currentPage": { "type": "integer", "description": "当前页" },
                  "pageSize": { "type": "integer", "description": "每页大小" },
                  "items": {
                    "type": "array",
                    "description": "账号列表",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "description": "账号ID" },
                        "code": { "type": "string", "description": "账号编码" },
                        "busCode": { "type": "string", "description": "业务编码" },
                        "status": { "type": "integer", "description": "账号状态" },
                        "statusStr": { "type": "string", "description": "账号状态文案" },
                        "account": { "type": "string", "description": "账号" },
                        "platform": { "type": "string", "description": "平台" },
                        "hostType": { "type": "integer", "description": "托管方式" },
                        "hostTypeStr": { "type": "string", "description": "托管方式文案" },
                        "email": { "type": "string", "description": "邮箱" },
                        "phone": { "type": "string", "description": "手机号" },
                        "accountType": { "type": "string", "description": "账号类型" },
                        "accountTypeStr": { "type": "string", "description": "账号类型文案" },
                        "platformLoginUrl": { "type": "string", "description": "平台登录地址" },
                        "passwordChangeUrl": { "type": "string", "description": "修改密码地址" },
                        "customField": { "type": "string", "description": "自定义字段" },
                        "passwordUpdateTime": { "type": "string", "description": "密码修改时间" },
                        "hasExpired": { "type": "boolean", "description": "密码是否过期" },
                        "incorrect": { "type": "integer", "description": "是否错误" },
                        "createBy": { "type": "string", "description": "创建人" },
                        "createTime": { "type": "string", "description": "创建时间" },
                        "updateBy": { "type": "string", "description": "修改人" },
                        "updateTime": { "type": "string", "description": "修改时间" },
                        "enabled": { "type": "boolean", "description": "是否启用" }
                      }
                    }
                  }
                }
              }
            }
          },
          "deprecated": false
        }
      ]
    }
  ]
}
