{
  "schemaVersion": "1",
  "manifestVersion": "2026-05-20T13:30:00+08:00",
  "modules": [
    {
      "domain": "orders",
      "description_cn": "订单查询",
      "keywords": ["订单", "orders", "order status"],
      "scenarios_cn": "运营查询订单状态、订单列表和订单明细。",
      "actions": [
        {
          "name": "list",
          "description_cn": "查询订单列表",
          "method": "GET",
          "path": "/v1/orders",
          "params": [
            { "name": "status", "type": "string", "required": false, "desc": "订单状态" },
            { "name": "limit", "type": "integer", "required": false, "default": 20, "desc": "返回数量" }
          ],
          "response": {
            "type": "array",
            "desc": "订单列表",
            "fields": [
              { "name": "orderId", "type": "string", "desc": "订单 ID", "usage": "可用于后续查询订单详情" },
              { "name": "status", "type": "string", "desc": "订单状态" },
              { "name": "createdAt", "type": "string", "desc": "创建时间" }
            ]
          },
          "deprecated": false
        }
      ]
    }
  ]
}
